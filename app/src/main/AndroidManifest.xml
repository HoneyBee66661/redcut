<?xml version="1.0" encoding="utf-8"?>
<!--
  :app manifest.

  Deliberately minimal. No permissions yet: importing media goes through the
  Storage Access Framework (FR-1.1), which needs a document picker, not
  READ_MEDIA_VIDEO — and asking for a permission the app does not use is how a
  video editor ends up looking like spyware on the Play listing.

  Phase 0.5 adds the Hilt application class reference and the nav graph host;
  Phase 4.1 adds the export foreground service with android:foregroundServiceType
  ="mediaProcessing".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".RedcutApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Redcut">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.Redcut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
